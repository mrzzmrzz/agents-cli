#!/usr/bin/env zsh
# agents — minimal AI coding-agent CLI manager
# https://github.com/mrzzmrzz/agents-cli
set -uo pipefail

# ── registry ──────────────────────────────────────────────────────────
# 每个 agent 一行元数据: via^install^update^uninstall
# 新增 agent 只需在 KNOWN 和 meta() 里各加一行
KNOWN=(claude codex amp pi opencode)

meta() {
  case "$1" in
    claude)   echo 'native^curl -fsSL https://claude.ai/install.sh | bash^claude update^rm -rf ~/.local/share/claude ~/.local/bin/claude' ;;
    codex)    echo 'npm^npm install -g @openai/codex@latest^npm install -g @openai/codex@latest^npm rm -g @openai/codex' ;;
    amp)      echo 'native^curl -fsSL https://ampcode.com/install.sh | bash^curl -fsSL https://ampcode.com/install.sh | bash^rm -rf ~/.amp ~/.local/bin/amp' ;;
    pi)       echo 'npm^npm install -g @earendil-works/pi-coding-agent@latest^npm install -g @earendil-works/pi-coding-agent@latest^npm rm -g @earendil-works/pi-coding-agent' ;;
    opencode) echo 'native^curl -fsSL https://opencode.ai/install | bash^opencode upgrade^rm -rf ~/.opencode ~/.local/bin/opencode' ;;
    *)        return 1 ;;
  esac
}

# ── ui ────────────────────────────────────────────────────────────────
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  BOLD=$'\e[1m' DIM=$'\e[2m' RST=$'\e[0m'
  GRN=$'\e[32m' YLW=$'\e[33m' RED=$'\e[31m' CYN=$'\e[36m'
else
  BOLD='' DIM='' RST='' GRN='' YLW='' RED='' CYN=''
fi
OK="${GRN}●${RST}" NOPE="${DIM}○${RST}" ARROW="${CYN}▸${RST}"

tilde() { print -r -- "${1/#$HOME/~}"; }
die()   { print -u2 "${RED}✗${RST} $*"; exit 1; }
note()  { print -r -- "$ARROW $*"; }

# 执行命令, 静默成功; 失败时回放输出
run() {
  local out; out=$(mktemp)
  if eval "$1" >"$out" 2>&1; then rm -f "$out"; return 0; fi
  print -u2 "${RED}── 输出 ──${RST}"; tail -20 "$out" >&2; rm -f "$out"; return 1
}

field() { meta "$1" | cut -d'^' -f"$2"; }
installed() { command -v "$1" >/dev/null 2>&1; }
version_of() { "$1" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+[0-9a-z.-]*' | head -1; }
known_or_die() { meta "$1" >/dev/null 2>&1 || die "未知 agent: ${BOLD}$1${RST} ${DIM}(agents list)${RST}"; }

# 版本列宽: 取已安装 agent 版本号的最大长度
ver_width() {
  local w=7 v
  for a in $KNOWN; do
    installed "$a" || continue
    v=$(version_of "$a"); (( ${#v} > w )) && w=${#v}
  done
  echo $w
}

# ── commands ──────────────────────────────────────────────────────────
cmd_show() {
  local found=0 vw=$(ver_width)
  for a in $KNOWN; do
    installed "$a" || continue
    found=1
    local p=$(command -v "$a") real=""
    [[ -L "$p" ]] && real="${DIM} → $(tilde "$(readlink -f "$p")")${RST}"
    printf "%s %s%-10s%s %s%-${vw}s%s %s%-8s%s %s%s\n" \
      "$OK" "$BOLD" "$a" "$RST" "$GRN" "$(version_of "$a")" "$RST" \
      "$DIM" "$(field "$a" 1)" "$RST" "$(tilde "$p")" "$real"
  done
  (( found )) || echo "没有已安装的 agent ${DIM}(agents list 查看可安装的)${RST}"
}

cmd_list() {
  local vw=$(ver_width)
  for a in $KNOWN; do
    if installed "$a"; then
      printf "%s %s%-10s%s %s%-${vw}s%s %s%s%s\n" \
        "$OK" "$BOLD" "$a" "$RST" "$GRN" "$(version_of "$a")" "$RST" "$DIM" "$(field "$a" 1)" "$RST"
    else
      printf "%s %s%-10s %-${vw}s %s%s\n" "$NOPE" "$DIM" "$a" "—" "$(field "$a" 2)" "$RST"
    fi
  done
}

cmd_install() {
  local target="${1:-}"
  [[ -z "$target" ]] && die "用法: agents install <name|all>"
  local list=()
  if [[ "$target" == all ]]; then
    for a in $KNOWN; do installed "$a" || list+=("$a"); done
    (( $#list )) || { note "全部已安装"; return; }
  else
    known_or_die "$target"
    installed "$target" && { note "${BOLD}$target${RST} 已安装 ${GRN}$(version_of "$target")${RST}"; return; }
    list=("$target")
  fi
  for a in $list; do
    note "安装 ${BOLD}$a${RST} ${DIM}$(field "$a" 2)${RST}"
    run "$(field "$a" 2)" || die "$a 安装失败"
    print -r -- "$OK ${BOLD}$a${RST} ${GRN}$(version_of "$a")${RST} 已安装"
  done
}

cmd_update() {
  local target="${1:-}"
  local list=()
  if [[ -n "$target" ]]; then
    known_or_die "$target"
    installed "$target" || die "$target 未安装"
    list=("$target")
  else
    for a in $KNOWN; do installed "$a" && list+=("$a"); done
  fi
  for a in $list; do
    local old=$(version_of "$a")
    printf "%s 更新 %s%-10s%s " "$ARROW" "$BOLD" "$a" "$RST"
    if ! run "$(field "$a" 3)"; then print -r -- "${RED}失败${RST}"; continue; fi
    local new=$(version_of "$a")
    if [[ "$old" == "$new" ]]; then
      print -r -- "${DIM}$new (已是最新)${RST}"
    else
      print -r -- "$old ${GRN}→ $new${RST}"
    fi
  done
}

cmd_uninstall() {
  local target="${1:-}"
  [[ -z "$target" ]] && die "用法: agents uninstall <name>"
  known_or_die "$target"
  installed "$target" || die "$target 未安装"
  local cmd=$(field "$target" 4)
  note "卸载 ${BOLD}$target${RST} ${DIM}$cmd${RST}"
  printf "确认? [y/N] "; read -r ans
  [[ "$ans" == [yY] ]] || { echo "取消"; return; }
  eval "$cmd" && print -r -- "$OK ${BOLD}$target${RST} 已卸载"
}

cmd_help() {
  cat <<EOF
${BOLD}agents${RST} — AI coding-agent 管理入口

  ${CYN}agents${RST} ${DIM}[show]${RST}           已安装的 agent (版本 / 渠道 / 路径)
  ${CYN}agents list${RST}             全部支持的 agent 及安装状态
  ${CYN}agents install${RST} <x|all>  安装
  ${CYN}agents update${RST} ${DIM}[x]${RST}       更新全部, 或只更新 x
  ${CYN}agents uninstall${RST} <x>    卸载 (需确认)

  ${DIM}别名: ls=list  up=update  rm=uninstall${RST}
EOF
}

# ── dispatch ──────────────────────────────────────────────────────────
case "${1:-show}" in
  show)          cmd_show ;;
  list|ls)       cmd_list ;;
  install)       cmd_install "${2:-}" ;;
  update|up)     cmd_update "${2:-}" ;;
  uninstall|rm)  cmd_uninstall "${2:-}" ;;
  -h|--help|help) cmd_help ;;
  *) die "未知命令: $1 ${DIM}(agents help)${RST}" ;;
esac
